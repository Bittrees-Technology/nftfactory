# Root operator env template for repo-level scripts.
# Fill the blank values, then export this file into your shell before running
# `npm run check:web-env`, `npm run check:deployments`, or the IPFS publish
# helpers from the repo root.
#
# This template is mainnet-first. Do not rely on the checked-in Sepolia snapshot
# for production rollout. For mainnet checks, set the real chain RPC and the
# exact deployed addresses explicitly.

NEXT_PUBLIC_PRIMARY_CHAIN_ID=1
NEXT_PUBLIC_ENABLED_CHAIN_IDS=1
CHAIN_ID=1

# Ethereum Mainnet (1)
NEXT_PUBLIC_REGISTRY_ADDRESS_1=
NEXT_PUBLIC_ROYALTY_SPLIT_REGISTRY_ADDRESS_1=
NEXT_PUBLIC_MODERATOR_REGISTRY_ADDRESS_1=
NEXT_PUBLIC_MARKETPLACE_ADDRESS_1=
NEXT_PUBLIC_SHARED_721_ADDRESS_1=
NEXT_PUBLIC_SHARED_1155_ADDRESS_1=
NEXT_PUBLIC_SUBNAME_REGISTRAR_ADDRESS_1=
NEXT_PUBLIC_FACTORY_ADDRESS_1=
NEXT_PUBLIC_RPC_URL_1=
# Optional comma-separated read-only failover list for the public web client.
NEXT_PUBLIC_RPC_URLS_1=
NEXT_PUBLIC_INDEXER_API_URL_1=
INDEXER_API_URL_1=
# Optional server-side request guard for /api/indexer proxy bodies. Defaults to 1048576 (1MB).
INDEXER_PROXY_MAX_BODY_BYTES=
# Optional best-effort per-IP cap for app-facing write requests forwarded through /api/indexer.
INDEXER_PROXY_WRITE_RATE_LIMIT_MAX_REQUESTS=
INDEXER_PROXY_WRITE_RATE_LIMIT_WINDOW_MS=
# Optional best-effort per-IP caps for the public write routes.
IPFS_METADATA_RATE_LIMIT_MAX_REQUESTS=
IPFS_METADATA_RATE_LIMIT_WINDOW_MS=
PROFILE_PUBLISH_RATE_LIMIT_MAX_REQUESTS=
PROFILE_PUBLISH_RATE_LIMIT_WINDOW_MS=
COLLECTION_VERIFY_RATE_LIMIT_MAX_REQUESTS=
COLLECTION_VERIFY_RATE_LIMIT_WINDOW_MS=

# Indexer-side contract wiring should match the same chain as the web app.
REGISTRY_ADDRESS=
MARKETPLACE_ADDRESS=
MODERATOR_REGISTRY_ADDRESS=
RPC_URL=
# Optional comma-separated failover list for indexer and verification scripts.
RPC_URLS=
ALCHEMY_SEPOLIA_RPC_URL=
INFURA_SEPOLIA_RPC_URL=
# Release gate overrides. Leave unset in production unless you intentionally accept the tradeoff.
ALLOW_SINGLE_RPC_UPSTREAM=
ALLOW_SHARED_RPC_HOST=
# Optional runtime-health requirement for event-led production indexing.
REQUIRE_INDEXER_WEBHOOKS_CONFIGURED=
# Optional backup freshness gate for operators running release checks on the host.
INDEXER_REQUIRE_FRESH_BACKUP=
INDEXER_BACKUP_DIR=
INDEXER_BACKUP_PATH=
INDEXER_BACKUP_MAX_AGE_HOURS=
INDEXER_BACKUP_REQUIRE_SIDECARS=
INDEXER_BACKUP_RETENTION_COUNT=
INDEXER_BACKUP_RETENTION_DAYS=
INDEXER_BACKUP_SYSTEMD_ONCALENDAR=
INDEXER_BACKUP_CRON_SCHEDULE=

# Optional secondary validation network.
SEPOLIA_RPC_URL=
NEXT_PUBLIC_RPC_URL_11155111=
NEXT_PUBLIC_RPC_URLS_11155111=
NEXT_PUBLIC_INDEXER_API_URL_11155111=
INDEXER_API_URL_11155111=
NEXT_PUBLIC_REGISTRY_ADDRESS_11155111=0x2A31aE082179E3AdbCfC4Cf27aC3c094Fd41F56f
NEXT_PUBLIC_ROYALTY_SPLIT_REGISTRY_ADDRESS_11155111=0x6617DD523409a78831E75E156f532d1F0402b5D8
NEXT_PUBLIC_MODERATOR_REGISTRY_ADDRESS_11155111=0x5F6F4f93127c9c04a142C5138523a734112fBE40
NEXT_PUBLIC_MARKETPLACE_ADDRESS_11155111=0xdB8429Eb30f36F8DB0146441645B7295fF37FfD0
NEXT_PUBLIC_SHARED_721_ADDRESS_11155111=0xA98Db2732baD732aA588cad65478D3153A48f606
NEXT_PUBLIC_SHARED_1155_ADDRESS_11155111=0xe0F306B9fB44C3d46C0360503D3B1b68366BA97d
NEXT_PUBLIC_SUBNAME_REGISTRAR_ADDRESS_11155111=0x549530BF5E17697d6C249Ba2b3E408aCA38f7b3F
NEXT_PUBLIC_FACTORY_ADDRESS_11155111=0xC3D1fbacC9BF055A8c125056aB46955A268c7c56

# Current Sepolia validation snapshot. Copy these into the non-suffixed indexer
# vars only when running the indexer against Sepolia.
# REGISTRY_ADDRESS=0x2A31aE082179E3AdbCfC4Cf27aC3c094Fd41F56f
# MARKETPLACE_ADDRESS=0xdB8429Eb30f36F8DB0146441645B7295fF37FfD0
# MODERATOR_REGISTRY_ADDRESS=0x5F6F4f93127c9c04a142C5138523a734112fBE40
# RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-key

NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Optional public deployed web origin used by runtime health/release checks.
RELEASE_WEB_BASE_URL=
# Optional public site origin fallback used by some publish helpers.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=
# Optional release smoke settings for protected deployments and one real creator route.
RELEASE_SMOKE_BASIC_AUTH_USERNAME=
RELEASE_SMOKE_BASIC_AUTH_PASSWORD=
RELEASE_PROFILE_ROUTE_NAME=
RELEASE_INCLUDE_PROFILE_MODERATION=
# Optional post-launch runtime monitor settings. Use a small pinned metadata CID
# if you want the monitor to probe a real public gateway path too.
RUNTIME_MONITOR_LABEL=
RUNTIME_MONITOR_WEBHOOK_URL=
RUNTIME_MONITOR_WEBHOOK_BEARER_TOKEN=
RUNTIME_MONITOR_STATE_FILE=
RUNTIME_MONITOR_IPFS_GATEWAY_CID=
# Optional server-only fallback for the web app layout/provider path.
WALLETCONNECT_PROJECT_ID=
ETHERSCAN_API_KEY=

# Root IPFS backend config shared with `projects/ipfs-evm-system` and the web upload route.
IPFS_API_BASE_URL=http://127.0.0.1:5001
IPFS_GATEWAY_BASE_URL=http://127.0.0.1:8080
# Optional comma-separated writable API failover list for checks and monitoring.
IPFS_API_URLS=
# Optional web-specific override. If unset, the web app falls back to IPFS_API_BASE_URL.
IPFS_API_URL=
IPFS_API_BEARER_TOKEN=
IPFS_API_BASIC_AUTH_USERNAME=
IPFS_API_BASIC_AUTH_PASSWORD=
ALLOW_PUBLIC_IPFS_API_WITHOUT_AUTH=
IPFS_DEFAULT_SOURCE_PROJECT=nftfactory
