# Run one indexer instance per chain. Example:
# CHAIN_ID=1 INDEXER_PORT=8787 RPC_URL=... pnpm dev
# CHAIN_ID=10 INDEXER_PORT=8788 RPC_URL=... pnpm dev
# For provider failover, set RPC_URLS to a comma-separated list. The first URL
# stays primary and the rest are used as fallbacks by viem transport fallback.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nftfactory
RPC_URL=
RPC_URLS=
ALCHEMY_SEPOLIA_RPC_URL=
INFURA_SEPOLIA_RPC_URL=
CHAIN_ID=1
INDEXER_PORT=8787
INDEXER_START_BLOCK=0
INDEXER_REGISTRY_START_BLOCK=0
INDEXER_COLLECTION_START_BLOCK=0
INDEXER_ADMIN_TOKEN=
INDEXER_ADMIN_ALLOWLIST=
# Local/dev only. Leave unset in shared or production environments so the process fails closed without admin auth.
INDEXER_ALLOW_UNPROTECTED_ADMIN=
INDEXER_WEBHOOK_SECRET=
REGISTRY_ADDRESS=
MARKETPLACE_ADDRESS=
MODERATOR_REGISTRY_ADDRESS=
SHARED_721_ADDRESS=
SHARED_1155_ADDRESS=
INDEXER_CUSTOM_COLLECTIONS_FILE=
INDEXER_BACKUP_DIR=
INDEXER_BACKUP_PATH=
INDEXER_BACKUP_MAX_AGE_HOURS=
INDEXER_BACKUP_REQUIRE_SIDECARS=
INDEXER_BACKUP_RETENTION_COUNT=
INDEXER_BACKUP_RETENTION_DAYS=
INDEXER_BACKUP_SYSTEMD_ONCALENDAR=
INDEXER_BACKUP_CRON_SCHEDULE=
# Current Sepolia validation snapshot:
# CHAIN_ID=11155111
# RPC_URL=http://127.0.0.1:8545
# ALCHEMY_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-key
# INFURA_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your-key
# RPC_URLS=http://127.0.0.1:8545,https://eth-sepolia.g.alchemy.com/v2/your-key,https://sepolia.infura.io/v3/your-key
# REGISTRY_ADDRESS=0x4530ab3ed550ec65fbcf2b1e4c2ccb5f82905b7f
# MARKETPLACE_ADDRESS=0xbde18862bc7ff0b72dd0a47ae2b746a53a800b4d
# MODERATOR_REGISTRY_ADDRESS=0x95ec5bf5f35642ebd4d32ab1c9762798f8c71478
# SHARED_721_ADDRESS=0x0c62a94095b73ec539b91607436bc42b8f9c7a91
# SHARED_1155_ADDRESS=0x0c5b5c23bc1a47c9c15d43cba1d51c0fad9dc477
# INDEXER_CUSTOM_COLLECTIONS_FILE=./scripts/custom-collections.example.json
INDEXER_REGISTRY_SYNC_TTL_MS=120000
INDEXER_COLLECTION_SYNC_TTL_MS=300000
INDEXER_LOG_CHUNK_SIZE=200
INDEXER_RPC_RETRY_BASE_MS=2000
INDEXER_RPC_RETRY_MAX_MS=30000
INDEXER_RPC_INTER_CHUNK_DELAY_MS=250
INDEXER_OWNER_COLLECTION_SYNC_RPC_COOLDOWN_MS=120000
INDEXER_SYNC_CONCURRENCY=1
INDEXER_STORAGE_PROFILE=full
INDEXER_MARKETPLACE_RETENTION_DAYS=0
INDEXER_ENABLE_REGISTRY_READ_SYNC=1
INDEXER_ENABLE_REGISTRY_INTERVAL_SYNC=0
INDEXER_ENABLE_OWNER_READ_SYNC=1
INDEXER_ENABLE_PARTICIPANT_READ_SYNC=1
INDEXER_ENABLE_PARTICIPANT_ACTIVITY_PERSISTENCE=1
INDEXER_ENABLE_MARKETPLACE_READ_SYNC=1
INDEXER_BACKFILL_LOG_CHUNK_SIZE=25
INDEXER_BACKFILL_RPC_RETRY_BASE_MS=2000
INDEXER_BACKFILL_RPC_RETRY_MAX_MS=30000
INDEXER_BACKFILL_INTER_CHUNK_DELAY_MS=500
# Set true only when running behind a trusted proxy/load balancer that sets X-Forwarded-For.
TRUST_PROXY=false

# Same private signing key as the web application; minimum 32 random bytes.
SESSION_SECRET=

# Mainnet RPC for optional ENS forward-resolution verification; absent means wallet-only profile writes.
ENS_IDENTITY_RPC_URL=
