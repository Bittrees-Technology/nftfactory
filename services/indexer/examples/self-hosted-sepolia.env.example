DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/nftfactory

# Storage-first execution-client recommendation:
# If reth is installed, the helper scripts now prefer it automatically.
# To force it explicitly:
#   EXECUTION_CLIENT=reth RETH_PRUNING_MODE=minimal npm run rpc:selfhosted:start

CHAIN_ID=11155111
INDEXER_PORT=8787

# Local self-hosted Sepolia node first.
RPC_URL=http://127.0.0.1:8545

# Keep one or two external providers as fallbacks during rollout.
ALCHEMY_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-key
INFURA_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your-key
RPC_URLS=http://127.0.0.1:8545,https://eth-sepolia.g.alchemy.com/v2/your-key,https://sepolia.infura.io/v3/your-key

INDEXER_START_BLOCK=10359500
INDEXER_REGISTRY_START_BLOCK=10359500
INDEXER_COLLECTION_START_BLOCK=10359500
INDEXER_ADMIN_TOKEN=replace-me
INDEXER_ADMIN_ALLOWLIST=0xYourAdminWallet
# Set to 1 only for isolated local/dev work when you intentionally want unprotected admin routes.
INDEXER_ALLOW_UNPROTECTED_ADMIN=

REGISTRY_ADDRESS=0x4530ab3ed550ec65fbcf2b1e4c2ccb5f82905b7f
MARKETPLACE_ADDRESS=0xbde18862bc7ff0b72dd0a47ae2b746a53a800b4d
MODERATOR_REGISTRY_ADDRESS=0x95ec5bf5f35642ebd4d32ab1c9762798f8c71478
SHARED_721_ADDRESS=0x0c62a94095b73ec539b91607436bc42b8f9c7a91
SHARED_1155_ADDRESS=0x0c5b5c23bc1a47c9c15d43cba1d51c0fad9dc477

INDEXER_STORAGE_PROFILE=core
INDEXER_MARKETPLACE_RETENTION_DAYS=14
INDEXER_ENABLE_REGISTRY_READ_SYNC=1
INDEXER_ENABLE_REGISTRY_INTERVAL_SYNC=0
INDEXER_ENABLE_OWNER_READ_SYNC=1
INDEXER_ENABLE_PARTICIPANT_READ_SYNC=0
INDEXER_ENABLE_PARTICIPANT_ACTIVITY_PERSISTENCE=0
INDEXER_ENABLE_MARKETPLACE_READ_SYNC=1
