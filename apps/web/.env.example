NEXT_PUBLIC_PRIMARY_CHAIN_ID=1
# Only include chains that are fully configured below.
# Leaving this blank makes the app auto-enable whatever configured chains it finds.
NEXT_PUBLIC_ENABLED_CHAIN_IDS=

# Legacy single-chain aliases. Keep these populated for the primary chain if needed.
NEXT_PUBLIC_CHAIN_ID=1
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_RPC_URLS=
NEXT_PUBLIC_INDEXER_API_URL=
INDEXER_API_URL=
# Optional server-side request guard for /api/indexer proxy bodies. Defaults to 1048576 (1MB).
INDEXER_PROXY_MAX_BODY_BYTES=
# Optional best-effort per-IP cap for app-facing write requests forwarded through /api/indexer.
INDEXER_PROXY_WRITE_RATE_LIMIT_MAX_REQUESTS=
INDEXER_PROXY_WRITE_RATE_LIMIT_WINDOW_MS=
# Optional best-effort per-IP caps for the public write routes.
# /api/ipfs/metadata defaults to 10 requests / 300000ms (5 minutes).
IPFS_METADATA_RATE_LIMIT_MAX_REQUESTS=
IPFS_METADATA_RATE_LIMIT_WINDOW_MS=
# /api/profile/publish defaults to 10 requests / 300000ms (5 minutes).
PROFILE_PUBLISH_RATE_LIMIT_MAX_REQUESTS=
PROFILE_PUBLISH_RATE_LIMIT_WINDOW_MS=
# /api/collections/verify defaults to 30 requests / 60000ms (1 minute).
COLLECTION_VERIFY_RATE_LIMIT_MAX_REQUESTS=
COLLECTION_VERIFY_RATE_LIMIT_WINDOW_MS=
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_ROYALTY_SPLIT_REGISTRY_ADDRESS=
NEXT_PUBLIC_MODERATOR_REGISTRY_ADDRESS=
NEXT_PUBLIC_MARKETPLACE_ADDRESS=
NEXT_PUBLIC_SHARED_721_ADDRESS=
NEXT_PUBLIC_SHARED_1155_ADDRESS=
NEXT_PUBLIC_SUBNAME_REGISTRAR_ADDRESS=
NEXT_PUBLIC_FACTORY_ADDRESS=

