# Required for QR/mobile WalletConnect sessions. Browser extension wallets do not use this path.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Optional server-only fallback for hosts that inject runtime envs without rebuilding the client bundle.
WALLETCONNECT_PROJECT_ID=
# Optional server-side explorer verification for creator collection proxies.
ETHERSCAN_API_KEY=
# Public URL reachable from the deployed web host (for example Vercel).
# The backend prefers the shared `projects/ipfs-evm-system` config package and
# falls back to these envs directly. Set IPFS_API_URL only when the web app
# should override the shared IPFS API base URL.
IPFS_API_URL=
# Optional comma-separated failover list. The web API upload route tries these in order.
IPFS_API_URLS=
# Shared IPFS backend config from `projects/ipfs-evm-system`.
IPFS_API_BASE_URL=
# Public IPFS APIs should usually be protected. Prefer a bearer token for the web -> IPFS service connection.
IPFS_API_BEARER_TOKEN=
# Basic auth is supported as a fallback when bearer auth is not available.
IPFS_API_BASIC_AUTH_USERNAME=
IPFS_API_BASIC_AUTH_PASSWORD=
# Set ALLOW_PUBLIC_IPFS_API_WITHOUT_AUTH=1 only if the endpoint is intentionally public.
ALLOW_PUBLIC_IPFS_API_WITHOUT_AUTH=
# Public gateway base. Use the host root; the app appends /ipfs/<cid>.
NEXT_PUBLIC_IPFS_GATEWAY=https://dweb.link
IPFS_GATEWAY_BASE_URL=

# Optional live-site password protection.
# If SITE_BASIC_AUTH_PASSWORD is set, the entire site and its API routes require HTTP Basic Auth.
SITE_BASIC_AUTH_USERNAME=viewer
SITE_BASIC_AUTH_PASSWORD=
SITE_BASIC_AUTH_ENABLED=
