{
  "name": "web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "bash ../../scripts/web-runtime-preflight.sh dev && next dev",
    "dev:clean": "bash ../../scripts/web-runtime-preflight.sh dev:clean && rm -rf .next && next dev",
    "build": "bash ../../scripts/web-runtime-preflight.sh build && NEXT_DIST_DIR=.next-build node ../../scripts/run-next-build.mjs",
    "build:clean": "bash ../../scripts/web-runtime-preflight.sh build:clean && rm -rf .next-build && NEXT_DIST_DIR=.next-build node ../../scripts/run-next-build.mjs",
    "start": "NEXT_DIST_DIR=.next-build next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.21",
    "@walletconnect/ethereum-provider": "2.24.0",
    "next": "16.3.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "viem": "^2.55.19",
    "wagmi": "3.7.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.13.4",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "jsdom": "^29.1.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
